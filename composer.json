{
    "name": "dbout/wp-foundation",
    "description": "Lightweight application foundation for WordPress: service container, attribute-based routing and WP-CLI commands, Twig views, validation, cache and security hardening, built on Symfony and Illuminate components.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "framework",
        "foundation",
        "container",
        "routing",
        "twig",
        "validation",
        "wp-cli",
        "symfony",
        "illuminate"
    ],
    "authors": [
        {
            "name": "Dimitri BOUTEILLE",
            "homepage": "https://github.com/dimitriBouteille"
        }
    ],
    "require": {
        "php": ">=8.3",
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/container": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.8.4",
        "psr/cache": "^3.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/cache": "^6.4.40",
        "symfony/http-foundation": "^6.4.46",
        "symfony/property-access": "^6.4 || ^7.0",
        "symfony/routing": "^6.4.41",
        "symfony/translation-contracts": "^3.0",
        "symfony/validator": "^6.4.11",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.27",
        "php-stubs/wordpress-stubs": "6.9.4",
        "php-stubs/wp-cli-stubs": "2.12.0",
        "phpstan/phpstan": "2.3.4",
        "rector/rector": "2.8.3"
    },
    "suggest": {
        "ext-gd": "Required by the towebp Twig filter (with the WebP support)",
        "wp-cli/wp-cli": "Required by the commands"
    },
    "autoload": {
        "psr-4": {
            "Dbout\\WpFoundation\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "csFixer": "php-cs-fixer fix --dry-run --diff",
        "csFixer:fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    }
}
